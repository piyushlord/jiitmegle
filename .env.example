# Frontend environment variables
# Copy this file to `.env` and fill in the values

# WebSocket signaling server URL
# - For local dev: leave empty (the dev server runs automatically on port 3001)
# - For production: set to your deployed Cloudflare Worker WebSocket URL
#   Example: wss://jiitmegle-signaling.your-subdomain.workers.dev
VITE_SIGNALING_URL=

# STUN server for WebRTC NAT traversal (free, public)
VITE_STUN_SERVER=stun:stun.l.google.com:19302
